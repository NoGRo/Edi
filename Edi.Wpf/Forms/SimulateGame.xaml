<Window x:Class="Edi.Forms.SimulateGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview Player" 
        Height="570"
        Width="280"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        MinWidth="170"
        MinHeight="330">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="168"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ProgressBar Grid.Row="0"
                     HorizontalAlignment="Stretch" 
                     VerticalAlignment="Stretch"
                     Margin="12,8"
                     Orientation="Vertical" 
                     Value="{Binding SimulatorDevice.ProgressValue}"/>

        <Border Grid.Row="1"
                BorderBrush="#DDD"
                BorderThickness="0,1,0,0"
                Padding="0,6,0,2"
                VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Name:" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SimulatorDevice.GalleryName}" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1" Text="Type:" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SimulatorDevice.GalleryType}"/>

                <TextBlock Grid.Row="2" Text="Loop:" FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SimulatorDevice.GalleryLoop}"/>

                <TextBlock Grid.Row="3" Text="Seek:" FontWeight="Bold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SimulatorDevice.GallerySeek}"/>

                <TextBlock Grid.Row="4" Text="Duration:" FontWeight="Bold"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SimulatorDevice.GalleryDuration}"/>

                <TextBlock Grid.Row="5" Text="Channel:" FontWeight="Bold"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SimulatorDevice.Channel, TargetNullValue=-}"/>

                <TextBlock Grid.Row="6" Text="Variant:" FontWeight="Bold"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SimulatorDevice.SelectedVariant, TargetNullValue=-}"/>
            </Grid>
        </Border>

        <CheckBox Grid.Row="2"
                  Content="Always on Top"
                  Margin="5"
                  HorizontalAlignment="Center"
                  Checked="OnAlwaysOnTopChecked"
                  Unchecked="OnAlwaysOnTopUnchecked"/>
    </Grid>
</Window>
