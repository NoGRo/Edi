@{
    ViewData["Title"] = "Player";
}

<style>
    .player-shell { max-width: 1100px; margin: 0 auto; }
    .player-video { width: 100%; max-height: 68vh; background: #111; border-radius: .5rem; }
    .player-status { min-height: 1.5rem; }
    .device-card { border: 1px solid #dee2e6; border-radius: .5rem; padding: 1rem; }
</style>

<div class="player-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">EDI Player</h1>
            <div id="playerStatus" class="player-status text-muted">Cargando galería...</div>
        </div>
        <button id="refreshPlayer" class="btn btn-outline-secondary" type="button">Actualizar</button>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <label for="videoSelect" class="form-label">Video</label>
            <select id="videoSelect" class="form-select mb-3" disabled>
                <option>Cargando videos...</option>
            </select>
            <video id="videoPlayer" class="player-video" preload="metadata" controls></video>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                <button id="playFullscreen" class="btn btn-success" type="button">Reproducir en pantalla completa</button>
                <button id="stopPlayer" class="btn btn-danger" type="button">Detener</button>
                <div class="form-check ms-sm-2">
                    <input id="autoplayCheck" class="form-check-input" type="checkbox">
                    <label class="form-check-label" for="autoplayCheck">Reproducir el siguiente automáticamente</label>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h4">Dispositivos</h2>
    <partial name="DeviceGridPartial" />
</div>

@section Scripts {
    <script src="~/js/edi-player.js" asp-append-version="true"></script>
    <script src="~/js/edi-devices.js" asp-append-version="true"></script>
}
