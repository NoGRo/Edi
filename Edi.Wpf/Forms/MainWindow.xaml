<Window x:Class="Edi.Forms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Edi.Forms"
        mc:Ignorable="d"
        Title="Edi Launcher"
        Height="670"
        Width="900"
        MinHeight="230"
        MinWidth="650"
        ResizeMode="CanResize">

    <Window.Resources>
        <local:BoolToReadyIconConverter x:Key="BoolToReadyIconConverter"/>
    </Window.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="280"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Settings and Controls -->
        <ScrollViewer Grid.Row="0"
                      Grid.Column="0"
                      Grid.RowSpan="2"
                      Margin="0,0,10,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Game Selection Group -->
            <GroupBox Header="Game &amp; General" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="GamesComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Path"
                                  ItemsSource="{Binding gamesConfig.GamesInfo}"
                                  SelectedItem="{Binding gamesConfig.SelectedGameinfo, Mode=TwoWay}"
                                  SelectionChanged="GamesComboBox_SelectionChanged"
                                  MinHeight="27"
                                  VerticalContentAlignment="Center"
                                  ToolTip="Choose one of your saved games"/>
                        <Button Grid.Column="1"
                                x:Name="EditGameButton"
                                Content="Edit"
                                MinWidth="52"
                                Margin="6,0,0,0"
                                IsEnabled="False"
                                Click="EditGameButton_Click"
                                ToolTip="Rename this game, change its file, or remove it"/>
                        <Button Grid.Column="2"
                                Content="+ Add game"
                                MinWidth="82"
                                Margin="6,0,0,0"
                                Click="AddGameButton_Click"
                                ToolTip="Choose a game file and add it to this list"/>
                    </Grid>

                    <Border x:Name="GameEditorPanel"
                            Visibility="Collapsed"
                            Background="#FFF5F7FA"
                            BorderBrush="#FFCBD3DC"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="GameEditorTitle"
                                       Text="Add game"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         x:Name="GameNameTextBox"
                                         MinHeight="25"
                                         VerticalContentAlignment="Center"
                                         ToolTip="The friendly name shown in the game list"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="File"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         x:Name="GamePathTextBox"
                                         IsReadOnly="True"
                                         MinHeight="25"
                                         VerticalContentAlignment="Center"
                                         HorizontalScrollBarVisibility="Auto"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button Grid.Column="2"
                                        Content="Change..."
                                        Margin="6,0,0,0"
                                        MinWidth="65"
                                        Click="ChangeGamePathButton_Click"
                                        ToolTip="Choose another EDI configuration or definitions file"/>
                            </Grid>
                            <TextBlock x:Name="GameEditorError"
                                       Foreground="#FFC62828"
                                       TextWrapping="Wrap"
                                       Margin="48,5,0,0"
                                       Visibility="Collapsed"/>
                            <Grid Margin="0,9,0,0">
                                <Button x:Name="DeleteGameButton"
                                        Content="Remove"
                                        HorizontalAlignment="Left"
                                        MinWidth="65"
                                        Click="DeleteGameButton_Click"
                                        ToolTip="Remove this game from the saved list"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            MinWidth="60"
                                            Click="CancelGameEditorButton_Click"/>
                                    <Button x:Name="SaveGameButton"
                                            Content="Save"
                                            MinWidth="90"
                                            Margin="6,0,0,0"
                                            IsDefault="True"
                                            Click="SaveGameButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,0,0,5">
                        <Label Content="Intensity:" VerticalAlignment="Center" Width="60"/>
                        <Label Content="{Binding ElementName=sliderIntensity, Path=Value}" DockPanel.Dock="Right" Width="30" HorizontalContentAlignment="Right"/>
                        <Slider x:Name="sliderIntensity" Value="100" Maximum="100" ValueChanged="Slider_ValueChanged" VerticalAlignment="Center" ToolTip="Global vibration/motion intensity"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                        <CheckBox Content="Filler" Margin="5,0" IsChecked="{Binding config.Filler, Mode=TwoWay}" ToolTip="Enable passive background motions"/>
                        <CheckBox Content="Gallery" Margin="5,0" IsChecked="{Binding config.Gallery, Mode=TwoWay}" ToolTip="Enable primary scene playback"/>
                        <CheckBox Content="Reaction" Margin="5,0" IsChecked="{Binding config.Reactive, Mode=TwoWay}" ToolTip="Enable short event responses"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Device Connection Group -->
            <GroupBox Header="Connection Settings" Margin="0,0,0,10" Padding="5">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <Label Content="Device Keys:"
                               Width="85"
                               VerticalAlignment="Center"/>
                        <TextBox Text="{Binding handyConfig.Key}"
                                 ToolTip="Your Handy, AutoBlow Ultra, or VacuGlide 2 connection key"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <Label Content="Intiface URL:" Width="85" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding buttplugConfig.Url}" ToolTip="Buttplug/Intiface Desktop server address"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <Label Content="E-Stim Device:" Width="85" VerticalAlignment="Center"/>
                        <ComboBox Name="audioDevicesComboBox" 
                                  DisplayMemberPath="name" 
                                  SelectedValuePath="id" 
                                  SelectedValue="{Binding estimConfig.DeviceId}" 
                                  ToolTip="Audio device for E-Stim (requires MP3 funscripts)"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <Label Content="OSR COM:" Width="85" VerticalAlignment="Center"/>
                        <ComboBox Name="comPortsComboBox" 
                                  DisplayMemberPath="name" 
                                  SelectedValuePath="value" 
                                  SelectedValue="{Binding osrConfig.COMPort}" 
                                  ToolTip="Serial port for OSR-TCode devices"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <Label Content="OSR UDP:" Width="85" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding osrConfig.UdpAddress}" ToolTip="UDP Address for OSR (e.g., 127.0.0.1:1234)"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <Label Content="DG-LAB PW v2:"
                               Width="100"
                               VerticalAlignment="Center"/>
                        <CheckBox Content="Detect BLE"
                                  Height="23"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  IsChecked="{Binding dgLabConfig.Enabled, Mode=TwoWay}"
                                  ToolTip="Detect DG-LAB PowerBox 2.0 devices over Bluetooth. Reconnect devices after changing this option."/>
                    </DockPanel>
                    <Button Content="Reconnect Devices" Margin="0,10,0,0" Height="25" x:Name="ReconnectButton" Click="ReconnectButton_ClickAsync" ToolTip="Refresh connections for all enabled devices"/>
                </StackPanel>
            </GroupBox>

            <!-- Manual Playback Group -->
            <GroupBox Header="Playback Control" Padding="5">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Gallery:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="cmbGallerie"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding galleries}"
                                  ToolTip="Select a gallery to play manually"/>
                        <ComboBox Grid.Column="2"
                                  Width="90"
                                  Margin="5,0,0,0"
                                  ItemsSource="{Binding playbackChannels}"
                                  SelectedItem="{Binding selectedChannel, Mode=TwoWay}"
                                  ToolTip="Select a playback channel or all channels">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding config.UseChannels}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>
                    <UniformGrid Columns="5" Height="30">
                        <Button x:Name="btnPlay" Click="btnPlay_Click" ToolTip="Play selected gallery">
                            <TextBlock Text="▶" FontSize="16"/>
                        </Button>
                        <Button x:Name="btnStop" Click="btnStop_Click" ToolTip="Stop playback">
                            <TextBlock Text="■" FontSize="16"/>
                        </Button>
                        <Button x:Name="btnPause" Click="btnPause_Click" ToolTip="Pause playback">
                            <TextBlock Text="❚❚" FontSize="14"/>
                        </Button>
                        <Button x:Name="btnResume" Click="btnResume_Click" ToolTip="Resume playback">
                            <TextBlock Text="►❚❚" FontSize="14"/>
                        </Button>
                        <Button x:Name="btnSimulator" Click="btnSimulator_Click" ToolTip="Toggle Visualizer Window">
                            <TextBlock Text="👁️" FontSize="16"/>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="#FFE0E4E8"
                      ShowsPreview="True"
                      ToolTip="Drag to resize the controls and devices panels"/>

        <!-- Right Column: Active Devices and Logs -->
        <GroupBox Header="Active Devices" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Padding="5">
            <DataGrid x:Name="DevicesGrid" ItemsSource="{Binding devices}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Device Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTemplateColumn Header="Variant" Width="100" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Variants}"
                                          SelectionChanged="Variants_SelectionChanged"
                                          SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Margin="2,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ready" Binding="{Binding IsReady, Converter={StaticResource BoolToReadyIconConverter}, Mode=OneWay}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Channel" x:Name="ChannelColumn" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.channels, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectionChanged="Channels_SelectionChanged"
                                          SelectedValue="{Binding Channel, Mode=TwoWay}" Width="80"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Settings" Width="62">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="DeviceConfiguration_Click"
                                        Margin="2,0"
                                        ToolTip="Configure this device">
                                    <TextBlock Text="⚙"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="16"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Footer: Status and Tools -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="5,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Status:" FontWeight="Bold"/>
                    <Label x:Name="lblStatus" Content="Ready"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Label Foreground="Blue" Content="API Documentation (Swagger)" Cursor="Hand" MouseDoubleClick="Label_MouseDoubleClick" ToolTip="Double-click to open API documentation in browser" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Button x:Name="btnLaunch"
                                Content="Launch"
                                Width="78"
                                Height="27"
                                IsEnabled="False"
                                Click="btnLaunch_Click"
                                ToolTip="Launch the configured game (requires a ready device)"/>
                        <CheckBox Content="Auto"
                                  Margin="7,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding config.AutoLaunch, Mode=TwoWay}"
                                  ToolTip="Automatically launch this game when a device becomes ready"/>
                    </StackPanel>
                    <Button Content="🛠" Width="25" x:Name="btnOpenOutput" Click="btnOpenOutput_Click" ToolTip="Open configuration/log directory"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

