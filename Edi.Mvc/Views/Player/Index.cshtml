@{
    ViewData["Title"] = "Player";
}

<style>
    .player-shell { width: calc(100vw - 1.5rem); max-width: none; margin-left: 50%; transform: translateX(-50%); }
    .player-card .card-body { padding: .5rem; }
    .video-stage { position: relative; width: 100%; background: #111; border-radius: .35rem; overflow: hidden; }
    .player-video { display: block; width: 100%; max-height: 75vh; background: #111; }
    .video-stage:fullscreen { display: flex; width: 100vw; height: 100vh; align-items: center; justify-content: center; border-radius: 0; background: #000; }
    .video-stage:fullscreen .player-video { width: 100%; height: 100%; max-height: none; object-fit: contain; }
    .custom-video-controls { position: absolute; z-index: 40; right: .75rem; bottom: .75rem; left: .75rem; padding: .55rem .65rem .45rem; border: 1px solid rgba(255,255,255,.14); border-radius: .55rem; background: linear-gradient(180deg, rgba(23,28,34,.82), rgba(12,15,18,.92)); color: #f8f9fa; box-shadow: 0 .35rem 1rem rgba(0,0,0,.3); opacity: 0; visibility: hidden; pointer-events: none; transform: translateY(.35rem); transition: opacity .16s ease, transform .16s ease, visibility .16s ease; backdrop-filter: blur(7px); }
    .video-stage.controls-visible .custom-video-controls,
    .custom-video-controls:focus-within { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0); }
    .custom-controls-row { display: flex; min-width: 0; align-items: center; gap: .55rem; }
    .custom-control-button { display: inline-flex; width: 2.15rem; height: 2.15rem; flex: 0 0 2.15rem; align-items: center; justify-content: center; padding: .25rem; border: 0; border-radius: .4rem; background: transparent; color: inherit; transition: color .12s ease, background-color .12s ease; }
    .custom-control-button:hover,
    .custom-control-button:focus-visible { background: rgba(255,255,255,.13); color: #8bb9ff; outline: none; }
    .custom-control-button:disabled { opacity: .4; }
    .custom-control-icon { width: 1.35rem; height: 1.35rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .custom-volume-control { display: flex; width: 2.15rem; min-width: 2.15rem; align-items: center; overflow: hidden; transition: width .18s ease; }
    .custom-volume-control:hover,
    .custom-volume-control:focus-within { width: 9rem; }
    .custom-volume-slider { --range-progress: 100%; width: 0; min-width: 0; margin: 0 .35rem 0 .25rem; opacity: 0; transition: width .18s ease, opacity .12s ease; }
    .custom-volume-control:hover .custom-volume-slider,
    .custom-volume-control:focus-within .custom-volume-slider { width: 6.15rem; opacity: 1; }
    .custom-time { flex: 0 0 auto; color: rgba(255,255,255,.82); font-size: .78rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .custom-controls-spacer { min-width: 0; flex: 1 1 auto; }
    .custom-seek-slider { --range-progress: 0%; display: block; width: 100%; height: .85rem; margin: .25rem 0 0; cursor: pointer; }
    .custom-video-controls input[type="range"] { height: 1rem; appearance: none; -webkit-appearance: none; background: transparent; }
    .custom-video-controls input[type="range"]::-webkit-slider-runnable-track { height: .24rem; border-radius: 999px; background: linear-gradient(to right, #6ea8fe 0 var(--range-progress), rgba(255,255,255,.25) var(--range-progress) 100%); }
    .custom-video-controls input[type="range"]::-webkit-slider-thumb { width: .85rem; height: .85rem; margin-top: -.305rem; border: 2px solid #d8e8ff; border-radius: 50%; appearance: none; -webkit-appearance: none; background: #6ea8fe; box-shadow: 0 1px 4px rgba(0,0,0,.45); }
    .custom-video-controls input[type="range"]::-moz-range-track { height: .24rem; border-radius: 999px; background: rgba(255,255,255,.25); }
    .custom-video-controls input[type="range"]::-moz-range-progress { height: .24rem; border-radius: 999px; background: #6ea8fe; }
    .custom-video-controls input[type="range"]::-moz-range-thumb { width: .7rem; height: .7rem; border: 2px solid #d8e8ff; border-radius: 50%; background: #6ea8fe; box-shadow: 0 1px 4px rgba(0,0,0,.45); }
    .custom-video-controls input[type="range"]:focus-visible { outline: 2px solid rgba(110,168,254,.7); outline-offset: 2px; }
    .video-stage:fullscreen .custom-video-controls { right: 1rem; bottom: 1rem; left: 1rem; }
    .player-status { min-height: 1.5rem; }
    .device-card { border: 1px solid #dee2e6; border-radius: .5rem; padding: .65rem .75rem; }
    .device-card .form-label { margin-bottom: .15rem; color: #6c757d; font-size: .75rem; line-height: 1.1; }
    .file-drop { border: 2px dashed #adb5bd; border-radius: .5rem; padding: .75rem; }
    .file-drop.drag-over { border-color: #0d6efd; background: #eef5ff; }
    .workspace-panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; align-items: start; }
    .workspace-panels.playlist-collapsed,
    .workspace-panels.devices-collapsed { grid-template-columns: minmax(0, 1fr); }
    .workspace-panel { min-width: 0; }
    .devices-panel { border: 1px solid #dee2e6; border-radius: .5rem; padding: .75rem; }
    .workspace-panel-header { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-height: 2.35rem; }
    .workspace-panel-title { min-width: 0; }
    .workspace-panel-content[hidden] { display: none; }
    .playlist-panel-actions { position: relative; display: flex; align-items: center; gap: .4rem; flex: 0 0 auto; }
    .playlist-secondary-actions { display: flex; gap: .4rem; }
    .workspace-panels:not(.devices-collapsed) .playlist-secondary-actions,
    .workspace-panels.playlist-collapsed.devices-collapsed .playlist-secondary-actions { position: absolute; top: 50%; right: calc(100% + .4rem); padding: .3rem; border: 1px solid #dee2e6; border-radius: .45rem; background: rgba(255,255,255,.97); box-shadow: 0 .25rem .75rem rgba(0,0,0,.16); opacity: 0; visibility: hidden; pointer-events: none; transform: translate(.3rem, -50%); transition: opacity .14s ease, transform .14s ease, visibility .14s ease; z-index: 15; }
    .workspace-panels:not(.devices-collapsed) .playlist-panel:hover .playlist-secondary-actions,
    .workspace-panels:not(.devices-collapsed) .playlist-panel:focus-within .playlist-secondary-actions,
    .workspace-panels.playlist-collapsed.devices-collapsed .playlist-panel:hover .playlist-secondary-actions,
    .workspace-panels.playlist-collapsed.devices-collapsed .playlist-panel:focus-within .playlist-secondary-actions { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(0, -50%); }
    .devices-panel .workspace-panel-content { margin-top: .75rem; }
    @@media (max-width: 900px) { .workspace-panels { grid-template-columns: minmax(0, 1fr); } }
    .playlist { list-style: none; min-height: 3rem; padding: 0; margin: .75rem 0 0; border-top: 1px solid #dee2e6; }
    .playlist.playlist-scroll { max-height: 30rem; overflow-y: auto; scrollbar-gutter: stable; }
    .playlist-item { position: relative; display: flex; align-items: center; gap: .5rem; min-height: 2.7rem; padding: .35rem .5rem; border-bottom: 1px solid #dee2e6; cursor: pointer; }
    .playlist-item:last-child { border-bottom: 0; }
    .playlist-item.active { background: #e7f1ff; }
    .playlist-item.dragging { opacity: .45; }
    .playlist-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .playlist-duration { width: 7rem; flex: 0 0 7rem; text-align: right; font-variant-numeric: tabular-nums; }
    .playlist-item-actions { display: flex; flex: 0 0 0; gap: .3rem; overflow: hidden; opacity: 0; visibility: hidden; pointer-events: none; transform: translateX(.25rem); transition: flex-basis .14s ease, opacity .12s ease, transform .12s ease, visibility .12s ease; }
    .playlist-item:hover .playlist-item-actions,
    .playlist-item:focus-within .playlist-item-actions { flex-basis: 2rem; opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(0); }
    .playlist-item-actions .icon-button { width: 2rem; height: 2rem; }
    .playlist-total { display: flex; flex-wrap: nowrap; justify-content: flex-end; gap: .75rem; padding: .45rem .5rem 0; overflow-x: auto; border-top: 1px solid #dee2e6; font-size: .85rem; font-weight: 600; }
    .playlist-total-item { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .2rem; white-space: nowrap; }
    .playlist-total .playlist-duration { width: auto; min-width: 3.25rem; flex: 0 0 auto; text-align: left; }
    .collapsed-current-video { display: block; max-width: min(42rem, calc(100vw - 3rem)); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; color: #212529; }
    .collapsed-current-video[hidden] { display: none; }
    .icon-button { display: inline-flex; align-items: center; justify-content: center; width: 2.35rem; height: 2.35rem; padding: .35rem; }
    .player-controls { display: flex; flex-wrap: nowrap; justify-content: space-between; gap: .75rem; align-items: center; }
    .player-toolbar { display: flex; min-width: 0; flex: 0 0 auto; align-items: center; gap: .5rem; }
    .player-toolbar .player-option-group { display: flex; flex: 0 0 auto; }
    .player-option { display: inline-flex; align-items: center; justify-content: center; min-width: 3rem; min-height: 2.5rem; }
    .player-option-group .player-option { width: 3rem; min-width: 3rem; flex: 0 0 3rem; }
    .player-option-icon { width: 1.55rem; height: 1.55rem; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; }
    .icon-button .utility-icon { width: 1.45rem; height: 1.45rem; stroke-width: 2; }
    .player-option-icon .icon-fill { fill: currentColor; stroke: none; }
    .loop-mode-indicator { fill: currentColor; stroke: none; font: 700 7px sans-serif; text-anchor: middle; }
    .stroker-slash { opacity: 0; transition: opacity .15s ease; }
    .stroker-paused .stroker-slash { opacity: 1; }
    .device-range-values { display: flex; justify-content: space-between; margin-bottom: .05rem; color: #6c757d; font-size: .72rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .device-range { --range-low: 0%; --range-high: 100%; position: relative; height: 1.55rem; }
    .device-range-track { position: absolute; inset: 50% 0 auto; height: .5rem; transform: translateY(-50%); border-radius: 999px; background: linear-gradient(to right, #dee2e6 0 var(--range-low), #0d6efd var(--range-low) var(--range-high), #dee2e6 var(--range-high) 100%); }
    .device-range-input { position: absolute; inset: 0; width: 100%; height: 1.55rem; margin: 0; padding: 0; appearance: none; -webkit-appearance: none; background: transparent; pointer-events: none; }
    .device-range-input::-webkit-slider-runnable-track { height: .5rem; background: transparent; }
    .device-range-input::-webkit-slider-thumb { width: 1.25rem; height: 1.25rem; margin-top: -.375rem; border: 2px solid #0d6efd; border-radius: 50%; appearance: none; -webkit-appearance: none; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.3); cursor: grab; pointer-events: auto; }
    .device-range-input::-moz-range-track { height: .5rem; background: transparent; }
    .device-range-input::-moz-range-thumb { width: 1rem; height: 1rem; border: 2px solid #0d6efd; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.3); cursor: grab; pointer-events: auto; }
    .device-range-input:focus-visible::-webkit-slider-thumb { outline: 3px solid rgba(13,110,253,.3); outline-offset: 2px; }
    .device-range-input:focus-visible::-moz-range-thumb { outline: 3px solid rgba(13,110,253,.3); outline-offset: 2px; }
    .variant-toggle-wrap { position: relative; z-index: 1090; display: flex; min-width: 0; flex: 0 0 auto; }
    .variant-toggle-button { line-height: 1; }
    .variant-toggle-button .variant-toggle-icon { width: 1.9rem; height: 1.9rem; stroke-width: 2.8; }
    .variant-toggle-panel { position: absolute; z-index: 1091; top: calc(100% + .4rem); right: 0; width: min(32rem, calc(100vw - 2rem)); padding: .85rem; border: 1px solid #dee2e6; border-radius: .5rem; background: #fff; box-shadow: 0 .5rem 1rem rgba(0,0,0,.15); }
    .variant-toggle-panel[hidden] { display: none; }
    .variant-toggle-status { min-height: 1.25rem; }
    button[data-tooltip] { position: relative; }
    button[data-tooltip]::before,
    button[data-tooltip]::after { position: absolute; left: 50%; z-index: 1080; pointer-events: none; opacity: 0; visibility: hidden; transition: opacity .12s ease, transform .12s ease, visibility .12s ease; }
    button[data-tooltip]::before { content: ""; bottom: calc(100% + .25rem); width: .55rem; height: .55rem; background: #252a30; transform: translate(-50%, .2rem) rotate(45deg); }
    button[data-tooltip]::after { content: attr(data-tooltip); bottom: calc(100% + .5rem); width: max-content; max-width: calc(100vw - 1rem); padding: .4rem .6rem; border-radius: .4rem; background: #252a30; color: #fff; box-shadow: 0 .2rem .65rem rgba(0,0,0,.25); font-size: .75rem; font-weight: 500; line-height: 1.25; text-align: center; white-space: normal; transform: translate(-50%, .2rem); }
    button[data-tooltip]:hover::before,
    button[data-tooltip]:hover::after,
    button[data-tooltip]:focus-visible::before,
    button[data-tooltip]:focus-visible::after { opacity: 1; visibility: visible; }
    button[data-tooltip]:hover::before,
    button[data-tooltip]:focus-visible::before { transform: translate(-50%, 0) rotate(45deg); }
    button[data-tooltip]:hover::after,
    button[data-tooltip]:focus-visible::after { transform: translate(-50%, 0); }
    button[data-tooltip]:hover::before,
    button[data-tooltip]:hover::after { transition-delay: .45s; }
    button[data-tooltip].tooltip-align-left::after { right: auto; left: 0; transform: translate(0, .2rem); }
    button[data-tooltip].tooltip-align-left:hover::after,
    button[data-tooltip].tooltip-align-left:focus-visible::after { transform: translate(0, 0); }
    button[data-tooltip].tooltip-align-right::after { right: 0; left: auto; transform: translate(0, .2rem); }
    button[data-tooltip].tooltip-align-right:hover::after,
    button[data-tooltip].tooltip-align-right:focus-visible::after { transform: translate(0, 0); }
    .video-stage.fullscreen-cursor-hidden,
    .video-stage.fullscreen-cursor-hidden * { cursor: none !important; }
    .video-stage.fullscreen-cursor-visible { cursor: default; }
    .fullscreen-device-controls { width: max-content; }
    .fullscreen-device-controls .variant-toggle-panel { top: calc(100% + .55rem); }
    .device-meta-line { display: grid; grid-template-columns: minmax(0, 1fr) minmax(8rem, 12rem) auto; gap: .65rem; align-items: center; }
    .device-meta-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .device-meta-variant { min-width: 0; }
    .device-range-field { margin-top: .55rem; }
</style>

<div class="player-shell" tabindex="-1">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">EDI Player</h1>
            <div id="playerStatus" class="player-status text-muted">Loading gallery...</div>
        </div>
        <div class="small text-muted">Press "F" to toggle fullscreen when a video is selected.</div>
    </div>

    <div class="card player-card mb-4">
        <div class="card-body">
            <input id="mediaFiles" class="visually-hidden" type="file" multiple
                   accept="video/*,.mp4,.webm,.avi,.mkv,.mov,.funscript,.mp3,.csv,.txt">
            <div id="workspacePanels" class="workspace-panels mb-3">
                <section id="fileDrop" class="file-drop workspace-panel playlist-panel">
                    <div class="workspace-panel-header">
                        <div class="workspace-panel-title">
                        <div class="d-flex align-items-center gap-2">
                            <strong>Playlist</strong>
                            <span id="playlistCount" class="small text-muted">0 videos</span>
                        </div>
                        <div id="collapsedCurrentVideo" class="collapsed-current-video small" hidden></div>
                        </div>
                        <div class="playlist-panel-actions">
                            <div class="playlist-secondary-actions">
                                <button id="addMediaFiles" class="btn btn-sm btn-primary icon-button" type="button"
                                        aria-label="Add videos and assets" data-tooltip="Add videos and assets">
                                    <svg class="player-option-icon utility-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5v15M4.5 12h15" /></svg>
                                </button>
                                <button id="refreshPlayer" class="btn btn-sm btn-outline-secondary icon-button" type="button"
                                        aria-label="Reload playlist assets" data-tooltip="Reload assets for the current playlist">
                                    <svg class="player-option-icon utility-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7.5 8.5L12 4l4.5 4.5M5 14v5h14v-5" /></svg>
                                </button>
                                <button id="clearPlaylist" class="btn btn-sm btn-outline-danger icon-button" type="button"
                                        aria-label="Clear playlist" data-tooltip="Clear the playlist and its assets">
                                    <svg class="player-option-icon utility-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17M9 6.5V4h6v2.5M6.5 6.5l1 13h9l1-13M10 10v6M14 10v6" /></svg>
                                </button>
                            </div>
                        <button id="togglePlaylist" class="btn btn-sm btn-outline-secondary icon-button" type="button"
                                    aria-controls="playlistPanelContent" aria-expanded="true" aria-label="Collapse playlist" data-tooltip="Collapse playlist">
                            <svg class="player-option-icon utility-icon" viewBox="0 0 24 24" aria-hidden="true"><path id="playlistToggleIcon" d="M5.5 14.5L12 8l6.5 6.5" /></svg>
                        </button>
                    </div>
                    </div>
                    <div id="playlistPanelContent" class="workspace-panel-content">
                        <div class="small text-muted mt-1">Drag videos and assets onto any part of this list.</div>
                        <ol id="videoPlaylist" class="playlist" aria-label="Video playlist">
                            <li class="p-3 text-muted">You have not added videos yet.</li>
                        </ol>
                        <div class="playlist-total">
                            <span class="playlist-total-item">
                                <span>Total playback:</span>
                                <span id="totalPlayback" class="playlist-duration">0:00</span>
                            </span>
                            <span class="playlist-total-item">
                                <span>Total duration:</span>
                                <span id="playlistDurationTotal" class="playlist-duration">0:00</span>
                            </span>
                        </div>
                    </div>
                </section>
                <section id="devicesPanel" class="workspace-panel devices-panel">
                    <div class="workspace-panel-header">
                        <strong>Devices</strong>
                        <button id="toggleDevices" class="btn btn-sm btn-outline-secondary icon-button" type="button"
                                aria-controls="devicesPanelContent" aria-expanded="true" aria-label="Collapse devices" data-tooltip="Collapse devices">
                            <svg class="player-option-icon utility-icon" viewBox="0 0 24 24" aria-hidden="true"><path id="devicesToggleIcon" d="M5.5 14.5L12 8l6.5 6.5" /></svg>
                        </button>
                    </div>
                    <div id="devicesPanelContent" class="workspace-panel-content">
                        <partial name="DeviceGridPartial" />
                    </div>
                </section>
            </div>
            <div class="player-controls mb-2">
                <div class="player-toolbar player-toolbar-playback">
                <button id="playFullscreen" class="btn btn-success icon-button" type="button" aria-label="Play in fullscreen" data-tooltip="Play in fullscreen">
                    <svg class="player-option-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" /></svg>
                </button>
                <button id="stopPlayer" class="btn btn-danger icon-button" type="button" aria-label="Stop playback" data-tooltip="Stop playback">
                    <svg class="player-option-icon" viewBox="0 0 24 24" aria-hidden="true"><rect class="icon-fill" x="6" y="6" width="12" height="12" rx="1" /></svg>
                </button>
                <div class="btn-group player-option-group" role="group" aria-label="Playback options">
                    <button id="autoplayToggle" class="btn btn-outline-secondary player-option" type="button"
                            aria-pressed="false" aria-label="Autoplay first video" data-tooltip="Autoplay the first video added">
                        <svg class="player-option-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path class="icon-fill" d="M3.5 5.2a1 1 0 0 1 1.5-.85l10.2 6.8a1 1 0 0 1 0 1.7L5 19.65a1 1 0 0 1-1.5-.85z" />
                            <path d="M19 5v14" />
                        </svg>
                    </button>
                    <button id="loopToggle" class="btn btn-outline-secondary player-option" type="button"
                            aria-pressed="false" aria-label="Repeat off" data-tooltip="Repeat off">
                        <svg class="player-option-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18.5 8A7 7 0 0 0 6.5 5.5L4 8M4 4v4h4M5.5 16A7 7 0 0 0 17.5 18.5L20 16M20 20v-4h-4" />
                            <text id="loopModeIndicator" class="loop-mode-indicator" x="12" y="14.5"></text>
                        </svg>
                    </button>
                    <button id="resumeToggle" class="btn btn-outline-secondary player-option" type="button"
                            aria-pressed="false" aria-label="Resume from last position" data-tooltip="Resume from the last position">
                        <svg class="player-option-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 3h12v18l-6-4-6 4z" />
                            <path class="icon-fill" d="M10 8l5 3-5 3z" />
                        </svg>
                    </button>
                </div>
                </div>
                <div class="player-toolbar player-toolbar-device">
                <div class="variant-toggle-wrap">
                    <div class="btn-group player-option-group" role="group" aria-label="Device controls">
                    <button id="strokerToggle" class="btn btn-outline-secondary player-option" type="button"
                            aria-pressed="false" aria-label="Space controls stroker" data-tooltip="Control the stroker with Space">
                        <svg class="player-option-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="7" y="2.5" width="10" height="19" rx="5" />
                            <path d="M12 6v12M9.5 8.5L12 6l2.5 2.5M9.5 15.5L12 18l2.5-2.5" />
                            <path class="stroker-slash" d="M3.5 3.5l17 17" style="stroke-width: 3.5" />
                        </svg>
                    </button>
                    <button id="intensityToggle" class="btn btn-outline-secondary player-option" type="button"
                            aria-pressed="false" aria-label="Intensity wheel" data-tooltip="Adjust intensity with the mouse wheel">
                        <svg class="player-option-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Four vertical bars of increasing height -->
                            <rect x="4" y="8" width="2" height="12" rx="0.5" />
                            <rect x="9" y="6" width="2" height="14" rx="0.5" />
                            <rect x="14" y="4" width="2" height="16" rx="0.5" />
                            <rect x="19" y="2" width="2" height="18" rx="0.5" />
                        </svg>
                    </button>
                    <button id="variantToggle" class="btn btn-outline-secondary player-option variant-toggle-button" type="button"
                            aria-pressed="false" aria-expanded="false" aria-controls="variantTogglePanel"
                            aria-label="Switch device variant" data-tooltip="Switch device variant">
                        <svg class="player-option-icon variant-toggle-icon" viewBox="0 0 28 24" aria-hidden="true">
                            <path d="M4 12h20M8 8l-4 4 4 4M20 8l4 4-4 4" />
                        </svg>
                    </button>
                    </div>
                    <div id="variantTogglePanel" class="variant-toggle-panel" hidden>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label" for="primaryVariant">Primary</label>
                                <select id="primaryVariant" class="form-select"></select>
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="secondaryVariant">Secondary</label>
                                <select id="secondaryVariant" class="form-select"></select>
                            </div>
                        </div>
                        <div id="variantToggleStatus" class="variant-toggle-status small text-muted mt-2"></div>
                    </div>
                </div>
                </div>
            </div>
            <div id="videoStage" class="video-stage">
                <video id="videoPlayer" class="player-video" preload="auto"></video>
                <div id="customVideoControls" class="custom-video-controls" role="group" aria-label="Video controls">
                    <div class="custom-controls-row">
                        <button id="customPlayPause" class="custom-control-button" type="button" aria-label="Play">
                            <svg class="custom-control-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path id="customPlayIcon" d="M7 4.5v15l12-7.5z" />
                                <path id="customPauseIcon" d="M8 5v14M16 5v14" />
                            </svg>
                        </button>
                        <div class="custom-volume-control">
                            <button id="customMute" class="custom-control-button" type="button" aria-label="Mute">
                                <svg class="custom-control-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M5 9h4l5-4v14l-5-4H5z" />
                                    <path id="customVolumeWaves" d="M17 9a4 4 0 0 1 0 6M19 6.5a8 8 0 0 1 0 11" />
                                    <path id="customVolumeSlash" d="M17 9l5 6M22 9l-5 6" />
                                </svg>
                            </button>
                            <input id="customVolume" class="custom-volume-slider" type="range" min="0" max="1" step="0.01" value="1" aria-label="Volume">
                        </div>
                        <span class="custom-time"><span id="customElapsed">0:00</span> / <span id="customDuration">0:00</span></span>
                        <span class="custom-controls-spacer"></span>
                        <button id="customFullscreen" class="custom-control-button" type="button" aria-label="Enter fullscreen">
                            <svg class="custom-control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" /></svg>
                        </button>
                    </div>
                    <input id="customSeek" class="custom-seek-slider" type="range" min="0" max="0" step="0.01" value="0" aria-label="Video position">
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/edi-player.js" asp-append-version="true"></script>
    <script src="~/js/edi-devices.js" asp-append-version="true"></script>
}
