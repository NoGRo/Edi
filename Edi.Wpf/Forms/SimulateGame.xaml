<Window x:Class="Edi.Forms.SimulateGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview Player"
        Height="713"
        Width="189"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        MinWidth="170"
        MinHeight="330">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Margin="12,8"
                     Orientation="Vertical"
                     Value="{Binding SimulatorDevice.ProgressValue}"/>

        <Border Grid.Row="1"
                BorderBrush="#DDD"
                BorderThickness="0,1,0,0"
                Padding="0,6,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Name:" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding SimulatorDevice.GalleryName}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Text="Type:" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding SimulatorDevice.GalleryType}"/>
                <TextBlock Grid.Row="2" Text="Loop:" FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding SimulatorDevice.GalleryLoop}"/>
                <TextBlock Grid.Row="3" Text="Seek:" FontWeight="Bold"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding SimulatorDevice.GallerySeek}"/>
                <TextBlock Grid.Row="4" Text="Current time:" FontWeight="Bold"/>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding SimulatorDevice.GalleryCurrentTime}"/>
                <TextBlock Grid.Row="5" Text="Duration:" FontWeight="Bold"/>
                <TextBlock Grid.Row="5" Grid.Column="1"
                           Text="{Binding SimulatorDevice.GalleryDuration}"/>
                <Grid x:Name="PreviewChannelRow"
                      Grid.Row="6"
                      Grid.ColumnSpan="2"
                      Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Channel:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SimulatorDevice.Channel, TargetNullValue=-}"/>
                </Grid>
                <TextBlock Grid.Row="7" Text="Variant:" FontWeight="Bold"/>
                <TextBlock Grid.Row="7" Grid.Column="1"
                           Text="{Binding SimulatorDevice.SelectedVariant, TargetNullValue=-}"/>
            </Grid>
        </Border>

        <Expander x:Name="RecordingExpander"
                  Grid.Row="2"
                  Header="Recording"
                  Margin="0,6"
                  IsExpanded="False"
                  Expanded="RecordingExpander_Expanded"
                  Collapsed="RecordingExpander_Collapsed">
            <Grid Height="210" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="RecordersGrid"
                          ItemsSource="{Binding RecorderSlots}"
                          SelectedItem="{Binding SelectedRecorderSlot, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Recorder"
                                            Binding="{Binding Name}"
                                            IsReadOnly="True"
                                            Width="*"/>
                        <DataGridTemplateColumn x:Name="RecorderChannelColumn"
                                                Header="Channel"
                                                Width="110"
                                                Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Channels, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.CanEditRecorders, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Variant" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Variants, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Variant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.CanEditRecorders, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            IsReadOnly="True"
                                            Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0">
                    <Button Content="+ Recorder"
                            Click="AddRecorder_Click"
                            IsEnabled="{Binding CanEditRecorders}"
                            Padding="8,3"
                            Margin="0,0,5,0"/>
                    <Button Content="Remove"
                            Click="RemoveRecorder_Click"
                            IsEnabled="{Binding CanEditRecorders}"
                            Padding="8,3"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0">
                    <Button x:Name="StartRecordingButton"
                            Content="Start recording"
                            Click="StartRecording_Click"
                            Padding="12,4"
                            Margin="0,0,6,0"/>
                    <Button x:Name="StopRecordingButton"
                            Content="Stop and save"
                            Click="StopRecording_Click"
                            Padding="12,4"
                            Margin="0,0,6,0"
                            IsEnabled="False"/>
                    <Button Content="📁"
                            Click="OpenRecordingsFolder_Click"
                            ToolTip="Open recordings folder"
                            FontFamily="Segoe UI Emoji"
                            FontSize="15"
                            Width="34"
                            Padding="4"/>
                </StackPanel>
            </Grid>
        </Expander>

        <CheckBox Grid.Row="3"
                  Content="Always on Top"
                  Margin="5"
                  HorizontalAlignment="Center"
                  Checked="OnAlwaysOnTopChecked"
                  Unchecked="OnAlwaysOnTopUnchecked"/>
    </Grid>
</Window>
